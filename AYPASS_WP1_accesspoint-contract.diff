diff --git a/lib/forms/accessPointPayload.ts b/lib/forms/accessPointPayload.ts
new file mode 100644
index 0000000..6040bb2
--- /dev/null
+++ b/lib/forms/accessPointPayload.ts
@@ -0,0 +1,125 @@
+import type {
+  AccessPoint,
+  AccessPointKind,
+  AccessPointStatus,
+  PricingMode,
+} from "@/lib/types/access-points";
+
+export interface AccessPointEditForm {
+  name: string;
+  vehicle_plate: string;
+  kind: AccessPointKind;
+  institution_id: string;
+  pricing_mode: PricingMode;
+  fee: number;
+  currency: string;
+  device_bindings: string[];
+  scheduled_route_ids: string[];
+  sale_product_ids: string[];
+  requires_approval: boolean;
+  cash_fallback_enabled: boolean;
+  pos_enabled: boolean;
+  status: AccessPointStatus;
+}
+
+// vehicle_plate and pos_enabled fall back to ""/false here only so the form has
+// something to render; prepareAccessPointUpdate refuses to send them when the
+// loaded record could not tell us the real value.
+export function accessPointToEditForm(ap: AccessPoint): AccessPointEditForm {
+  return {
+    name: ap.name,
+    vehicle_plate: ap.vehicle_plate ?? "",
+    kind: ap.kind,
+    institution_id: ap.institution_id ?? "",
+    pricing_mode: ap.pricing_mode,
+    fee: ap.fee ?? 0,
+    currency: ap.currency ?? "TRY",
+    device_bindings: ap.device_bindings ?? [],
+    scheduled_route_ids: ap.scheduled_route_ids ?? [],
+    sale_product_ids: ap.sale_product_ids ?? [],
+    requires_approval: ap.requires_approval ?? false,
+    cash_fallback_enabled: ap.cash_fallback_enabled ?? false,
+    pos_enabled: ap.pos_enabled ?? false,
+    status: ap.status,
+  };
+}
+
+// The backend's Service.Update assigns vehicle_plate and pos_enabled
+// unconditionally, so leaving either out of the PUT clears it. Both are always
+// sent, "" and false included.
+export function buildAccessPointUpdatePayload(
+  form: AccessPointEditForm,
+): Partial<AccessPoint> {
+  return {
+    ...form,
+    institution_id: form.institution_id || undefined,
+    device_bindings: form.device_bindings,
+  };
+}
+
+export type PreservedAccessPointField = "vehicle_plate" | "pos_enabled";
+
+export type AccessPointUpdateBlockReason =
+  | "not_loaded"
+  | "id_mismatch"
+  | "unreadable_fields";
+
+export type AccessPointUpdate =
+  | { ok: true; payload: Partial<AccessPoint> }
+  | { ok: false; reason: "not_loaded" }
+  | { ok: false; reason: "id_mismatch" }
+  | { ok: false; reason: "unreadable_fields"; unreadable: PreservedAccessPointField[] };
+
+// prepareAccessPointUpdate refuses to build an update payload unless the
+// loaded record both IS the record being edited (expectedId, from the route,
+// matches loaded.id — guards a stale load() racing a route-param change) and
+// carries a readable vehicle_plate/pos_enabled. A record from the wrong id
+// cannot be trusted for anything, so no field list is reported for that case.
+export function prepareAccessPointUpdate(
+  loaded: AccessPoint | null,
+  expectedId: string,
+  form: AccessPointEditForm,
+): AccessPointUpdate {
+  if (!loaded) return { ok: false, reason: "not_loaded" };
+  if (loaded.id !== expectedId) return { ok: false, reason: "id_mismatch" };
+  const unreadable: PreservedAccessPointField[] = [];
+  if (loaded.vehicle_plate === undefined) unreadable.push("vehicle_plate");
+  if (loaded.pos_enabled === undefined) unreadable.push("pos_enabled");
+  if (unreadable.length > 0) return { ok: false, reason: "unreadable_fields", unreadable };
+  return { ok: true, payload: buildAccessPointUpdatePayload(form) };
+}
+
+export type AccessPointSaveResult =
+  | { status: "blocked"; reason: "not_loaded" }
+  | { status: "blocked"; reason: "id_mismatch" }
+  | { status: "blocked"; reason: "unreadable_fields"; unreadable: PreservedAccessPointField[] }
+  | { status: "saved"; ap: AccessPoint }
+  | { status: "save_failed"; error: unknown };
+
+// performAccessPointSave is the entire decision+dispatch the edit page's
+// submit handler delegates to — prepare, and only on ok:true call `update`.
+// It exists so a test can assert, with a real call-counting stub in place of
+// accessPointsApi.update, that a blocked save never reaches the update
+// client (not just that prepareAccessPointUpdate returns ok:false in
+// isolation). The page's own code is then only the glue around this:
+// collecting item/id/form, calling this, and mapping the result to a notice.
+export async function performAccessPointSave(
+  loaded: AccessPoint | null,
+  expectedId: string,
+  form: AccessPointEditForm,
+  update: (id: string, payload: Partial<AccessPoint>) => Promise<AccessPoint>,
+): Promise<AccessPointSaveResult> {
+  const prepared = prepareAccessPointUpdate(loaded, expectedId, form);
+  if (prepared.ok === false) {
+    if (prepared.reason === "unreadable_fields") {
+      return { status: "blocked", reason: "unreadable_fields", unreadable: prepared.unreadable };
+    }
+    return { status: "blocked", reason: prepared.reason };
+  }
+  try {
+    const ap = await update(expectedId, prepared.payload);
+    return { status: "saved", ap };
+  } catch (error) {
+    return { status: "save_failed", error };
+  }
+}
