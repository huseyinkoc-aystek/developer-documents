@@ -0,0 +1,264 @@
+package service
+
+import (
+	"context"
+	"testing"
+
+	"github.com/aystek/aystek-core/internal/modules/access_points/model"
+	"go.mongodb.org/mongo-driver/bson/primitive"
+)
+
+// These tests cover requireDeviceBoundToAccessPoint's guard on RecordEvent,
+// SettleTripCash, CancelBoardingTrip and RecordWalkOnCashEntry — the four
+// access_points operations the device gateway (cmd/api/main.go's
+// apiGatewayGroup) reaches by AccessPoint id. Each rejection test asserts not
+// only the returned error but, using the existing fakes' own call/item
+// tracking (fakeAccessEventRepo.items, fakeRiderTripResolver.cancelCalls),
+// that the operation's side effect did not happen — not just that an error
+// came back.
+
+func TestRecordEvent_UnboundDevice_RejectedBeforeAnyEventIsWritten(t *testing.T) {
+	svc, apRepo, evRepo, _, _ := newTestService()
+	apID := apRepo.seed(t, model.AccessPoint{
+		Name: "Kantin", Kind: model.AccessPointKindCustom, PricingMode: model.PricingModeFree,
+		Currency: "TRY", Status: model.AccessPointStatusActive, DeviceBindings: []string{"bound-device"},
+	})
+
+	_, err := svc.RecordEvent(context.Background(), apID, RecordEventInput{
+		ActorID: "unbound-device", CallerIsAPIClient: true,
+	})
+
+	if err != ErrDeviceNotBoundToAccessPoint {
+		t.Fatalf("expected ErrDeviceNotBoundToAccessPoint, got %v", err)
+	}
+	if len(evRepo.items) != 0 {
+		t.Fatalf("expected no event to be written, got %d", len(evRepo.items))
+	}
+}
+
+func TestRecordEvent_BoundDevice_Allowed(t *testing.T) {
+	svc, apRepo, evRepo, _, _ := newTestService()
+	apID := apRepo.seed(t, model.AccessPoint{
+		Name: "Kantin", Kind: model.AccessPointKindCustom, PricingMode: model.PricingModeFree,
+		Currency: "TRY", Status: model.AccessPointStatusActive, DeviceBindings: []string{"bound-device"},
+	})
+
+	ev, err := svc.RecordEvent(context.Background(), apID, RecordEventInput{
+		ActorID: "bound-device", CallerIsAPIClient: true,
+	})
+
+	if err != nil {
+		t.Fatalf("expected the bound device to succeed, got %v", err)
+	}
+	if len(evRepo.items) != 1 || ev == nil {
+		t.Fatalf("expected exactly 1 event to be written, got %d", len(evRepo.items))
+	}
+}
+
+func TestRecordEvent_HumanAdmin_NotSubjectToDeviceBinding(t *testing.T) {
+	svc, apRepo, evRepo, _, _ := newTestService()
+	apID := apRepo.seed(t, model.AccessPoint{
+		Name: "Kantin", Kind: model.AccessPointKindCustom, PricingMode: model.PricingModeFree,
+		Currency: "TRY", Status: model.AccessPointStatusActive, DeviceBindings: []string{"some-other-device"},
+	})
+
+	// CallerIsAPIClient defaults to false (the zero value) — same as every
+	// existing admin-panel call site, none of which sets it.
+	_, err := svc.RecordEvent(context.Background(), apID, RecordEventInput{ActorID: "admin-user-1"})
+
+	if err != nil {
+		t.Fatalf("expected a human admin call to be unaffected by DeviceBindings, got %v", err)
+	}
+	if len(evRepo.items) != 1 {
