+// "not bound", same as an id that is simply absent from DeviceBindings.
+// DeviceBindings has no per-entry status of its own in the current model —
+// removing a client id from the array is the only way to revoke it; this
+// does not invent one.
+func (s *Service) requireDeviceBoundToAccessPoint(ap *model.AccessPoint, callerIsAPIClient bool, apiClientID string) error {
+	if !callerIsAPIClient {
+		return nil
+	}
+	if err := requireActiveAccessPoint(ap); err != nil {
+		log.Printf("access_points: rejected device %q for access point %s: inactive", apiClientID, ap.ID.Hex())
+		return ErrDeviceNotBoundToAccessPoint
+	}
+	clientID := strings.TrimSpace(apiClientID)
+	if clientID != "" {
+		for _, bound := range ap.DeviceBindings {
+			if bound == clientID {
+				return nil
+			}
+		}
+	}
+	log.Printf("access_points: rejected device %q for access point %s: not bound", apiClientID, ap.ID.Hex())
+	return ErrDeviceNotBoundToAccessPoint
