+	c.Set("user_type", "api_client")
+	c.Set("userID", "unbound-device")
+
+	h.SettleTripCash(c)
+
+	if w.Code != http.StatusForbidden {
+		t.Fatalf("expected 403, got %d (body: %s)", w.Code, w.Body.String())
