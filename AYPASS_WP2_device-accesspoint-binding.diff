@@ -0,0 +1,313 @@
+package handler
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/aystek/aystek-core/internal/modules/access_points/model"
+	"github.com/aystek/aystek-core/internal/modules/access_points/repository"
+	"github.com/aystek/aystek-core/internal/modules/access_points/service"
+	"github.com/gin-gonic/gin"
+	"go.mongodb.org/mongo-driver/bson/primitive"
+)
+
+// This file is the HTTP-level counterpart to
+// internal/modules/access_points/service/device_binding_test.go — it drives
+// the real AdminHandler.RecordEvent/SettleTripCash/CancelBoardingTrip/
+// RecordWalkOnCashEntry through gin, with a real *service.Service (backed by
+// minimal in-memory fakes of the two exported repository interfaces), to
+// check the actual HTTP status code AND, via the fake AccessEventRepository's
+// own insert count, that a rejected call never reaches the point of writing
+// anything — not just that the status code looks right.
+
+type fakeDeviceBindingAccessPointRepo struct {
+	points map[primitive.ObjectID]model.AccessPoint
+}
+
+func newFakeDeviceBindingAccessPointRepo() *fakeDeviceBindingAccessPointRepo {
+	return &fakeDeviceBindingAccessPointRepo{points: map[primitive.ObjectID]model.AccessPoint{}}
+}
+
+func (r *fakeDeviceBindingAccessPointRepo) seed(ap model.AccessPoint) primitive.ObjectID {
+	if ap.ID.IsZero() {
+		ap.ID = primitive.NewObjectID()
+	}
+	r.points[ap.ID] = ap
+	return ap.ID
+}
+
+func (r *fakeDeviceBindingAccessPointRepo) Insert(ctx context.Context, ap model.AccessPoint) (primitive.ObjectID, error) {
+	return r.seed(ap), nil
+}
+func (r *fakeDeviceBindingAccessPointRepo) Update(ctx context.Context, id primitive.ObjectID, ap model.AccessPoint) error {
+	r.points[id] = ap
+	return nil
+}
+func (r *fakeDeviceBindingAccessPointRepo) FindByID(ctx context.Context, id primitive.ObjectID) (*model.AccessPoint, error) {
+	ap, ok := r.points[id]
+	if !ok {
+		return nil, mongoNoDocuments{}
+	}
+	return &ap, nil
+}
+func (r *fakeDeviceBindingAccessPointRepo) FindByDeviceBinding(ctx context.Context, binding string) (*model.AccessPoint, error) {
+	panic("not used in this test")
+}
+func (r *fakeDeviceBindingAccessPointRepo) AddDeviceBinding(ctx context.Context, id primitive.ObjectID, clientID string) error {
+	panic("not used in this test")
+}
+func (r *fakeDeviceBindingAccessPointRepo) List(ctx context.Context, filter repository.AccessPointListFilter) ([]model.AccessPoint, int64, error) {
+	panic("not used in this test")
+}
+func (r *fakeDeviceBindingAccessPointRepo) SoftDelete(ctx context.Context, id primitive.ObjectID) error {
+	panic("not used in this test")
+}
+
+// mongoNoDocuments stands in for mongo.ErrNoDocuments without importing the
+// driver here — RecordEvent only checks err != nil, never its identity.
+type mongoNoDocuments struct{}
+
+func (mongoNoDocuments) Error() string { return "not found" }
+
+type fakeDeviceBindingAccessEventRepo struct {
+	inserted []model.AccessEvent
+}
+
+func (r *fakeDeviceBindingAccessEventRepo) Insert(ctx context.Context, ev model.AccessEvent) (primitive.ObjectID, error) {
+	if ev.ID.IsZero() {
+		ev.ID = primitive.NewObjectID()
+	}
+	r.inserted = append(r.inserted, ev)
+	return ev.ID, nil
+}
+func (r *fakeDeviceBindingAccessEventRepo) FindByID(ctx context.Context, id primitive.ObjectID) (*model.AccessEvent, error) {
+	for _, ev := range r.inserted {
+		if ev.ID == id {
+			return &ev, nil
+		}
+	}
+	return nil, mongoNoDocuments{}
+}
+func (r *fakeDeviceBindingAccessEventRepo) FindByIdempotencyKey(ctx context.Context, key string) (*model.AccessEvent, error) {
+	return nil, mongoNoDocuments{}
+}
+func (r *fakeDeviceBindingAccessEventRepo) ListByAccessPoint(ctx context.Context, accessPointID primitive.ObjectID, filter repository.AccessEventListFilter) ([]model.AccessEvent, int64, error) {
+	panic("not used in this test")
+}
+func (r *fakeDeviceBindingAccessEventRepo) ListByPerson(ctx context.Context, personID primitive.ObjectID, filter repository.AccessEventListFilter) ([]model.AccessEvent, int64, error) {
+	panic("not used in this test")
+}
+func (r *fakeDeviceBindingAccessEventRepo) ListByTripAssignment(ctx context.Context, tripAssignmentID primitive.ObjectID, filter repository.AccessEventListFilter) ([]model.AccessEvent, int64, error) {
+	panic("not used in this test")
+}
+func (r *fakeDeviceBindingAccessEventRepo) UpdateRefundStatus(ctx context.Context, id primitive.ObjectID, refundedBy string) error {
+	panic("not used in this test")
+}
+func (r *fakeDeviceBindingAccessEventRepo) CountByDiscountRuleSince(ctx context.Context, ruleID, personID primitive.ObjectID, since time.Time) (int64, error) {
+	return 0, nil
+}
+func (r *fakeDeviceBindingAccessEventRepo) FindMostRecentByDiscountRule(ctx context.Context, ruleID, personID primitive.ObjectID) (*time.Time, error) {
+	return nil, nil
+}
+func (r *fakeDeviceBindingAccessEventRepo) CountCorporateQuotaUsageSince(ctx context.Context, institutionID primitive.ObjectID, since time.Time) (int64, error) {
+	return 0, nil
+}
+func (r *fakeDeviceBindingAccessEventRepo) SummarizeByDiscountRule(ctx context.Context, ruleID primitive.ObjectID) (int64, float64, error) {
+	panic("not used in this test")
+}
+func (r *fakeDeviceBindingAccessEventRepo) SummarizeByPersonIDs(ctx context.Context, personIDs []primitive.ObjectID) (int64, float64, error) {
+	panic("not used in this test")
+}
+func (r *fakeDeviceBindingAccessEventRepo) SummarizeByKind(ctx context.Context, filter repository.SummaryFilter) ([]repository.KindSummaryRow, error) {
+	panic("not used in this test")
+}
+func (r *fakeDeviceBindingAccessEventRepo) SummarizeByScheduledRoute(ctx context.Context, filter repository.SummaryFilter) ([]repository.ScheduledRouteSummaryRow, error) {
+	panic("not used in this test")
+}
+func (r *fakeDeviceBindingAccessEventRepo) SummarizeByPerson(ctx context.Context, filter repository.SummaryFilter) ([]repository.PersonSummaryRow, error) {
+	panic("not used in this test")
+}
+
+// newDeviceBindingTestHandler wires a real *service.Service (nil for every
+// dependency PricingModeFree/Kind=Custom never touches — wallets, ledger,
+// subscriptions, discounts, institutions, route/trip resolvers — same "absent
+// dependency = skip" convention the service package's own tests rely on) so
+// RecordEvent's happy path needs nothing beyond the two repositories here.
+func newDeviceBindingTestHandler() (*AdminHandler, *fakeDeviceBindingAccessPointRepo, *fakeDeviceBindingAccessEventRepo) {
+	apRepo := newFakeDeviceBindingAccessPointRepo()
+	evRepo := &fakeDeviceBindingAccessEventRepo{}
+	svc := service.New(apRepo, evRepo, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)
+	return NewAdminHandler(svc), apRepo, evRepo
+}
+
+func newDeviceBindingTestContext(method, path, body string, params gin.Params) (*gin.Context, *httptest.ResponseRecorder) {
+	gin.SetMode(gin.TestMode)
+	w := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(w)
+	c.Request = httptest.NewRequest(method, path, strings.NewReader(body))
+	c.Request.Header.Set("Content-Type", "application/json")
+	c.Params = params
+	return c, w
+}
+
+func TestHTTP_RecordEvent_UnboundDevice_Returns403AndWritesNothing(t *testing.T) {
+	h, apRepo, evRepo := newDeviceBindingTestHandler()
+	apID := apRepo.seed(model.AccessPoint{
+		Name: "Kantin", Kind: model.AccessPointKindCustom, PricingMode: model.PricingModeFree,
+		Currency: "TRY", Status: model.AccessPointStatusActive, DeviceBindings: []string{"bound-device"},
+	})
+	c, w := newDeviceBindingTestContext(http.MethodPost, "/device/access-points/"+apID.Hex()+"/events", "{}",
+		gin.Params{{Key: "id", Value: apID.Hex()}})
+	c.Set("user_type", "api_client")
+	c.Set("userID", "unbound-device")
+
+	h.RecordEvent(c)
+
+	if w.Code != http.StatusForbidden {
+		t.Fatalf("expected 403, got %d (body: %s)", w.Code, w.Body.String())
+	}
+	if len(evRepo.inserted) != 0 {
+		t.Fatalf("expected no event to be written, got %d", len(evRepo.inserted))
+	}
+}
+
+func TestHTTP_RecordEvent_BoundDevice_Returns201AndWritesOne(t *testing.T) {
+	h, apRepo, evRepo := newDeviceBindingTestHandler()
+	apID := apRepo.seed(model.AccessPoint{
+		Name: "Kantin", Kind: model.AccessPointKindCustom, PricingMode: model.PricingModeFree,
+		Currency: "TRY", Status: model.AccessPointStatusActive, DeviceBindings: []string{"bound-device"},
+	})
+	c, w := newDeviceBindingTestContext(http.MethodPost, "/device/access-points/"+apID.Hex()+"/events", "{}",
+		gin.Params{{Key: "id", Value: apID.Hex()}})
+	c.Set("user_type", "api_client")
+	c.Set("userID", "bound-device")
+
+	h.RecordEvent(c)
+
+	if w.Code != http.StatusCreated {
+		t.Fatalf("expected 201, got %d (body: %s)", w.Code, w.Body.String())
+	}
+	if len(evRepo.inserted) != 1 {
+		t.Fatalf("expected exactly 1 event to be written, got %d", len(evRepo.inserted))
+	}
+}
+
+func TestHTTP_RecordEvent_HumanAdmin_UnaffectedByDeviceBindings(t *testing.T) {
+	h, apRepo, evRepo := newDeviceBindingTestHandler()
+	apID := apRepo.seed(model.AccessPoint{
+		Name: "Kantin", Kind: model.AccessPointKindCustom, PricingMode: model.PricingModeFree,
+		Currency: "TRY", Status: model.AccessPointStatusActive, DeviceBindings: []string{"some-other-device"},
+	})
+	c, w := newDeviceBindingTestContext(http.MethodPost, "/access-points/"+apID.Hex()+"/events", "{}",
+		gin.Params{{Key: "id", Value: apID.Hex()}})
+	// No "user_type" set at all — the plain admin auth path, same as the
+	// real human-admin route registration (access_points/routes.go).
+	c.Set("userID", "admin-user-1")
+
+	h.RecordEvent(c)
+
+	if w.Code != http.StatusCreated {
+		t.Fatalf("expected 201 for a human admin regardless of DeviceBindings, got %d (body: %s)", w.Code, w.Body.String())
+	}
+	if len(evRepo.inserted) != 1 {
+		t.Fatalf("expected exactly 1 event to be written, got %d", len(evRepo.inserted))
+	}
+}
+
+func TestHTTP_RecordEvent_WrongAccessPointInURL_Returns403NotTheOtherOnesData(t *testing.T) {
+	// An attempt to use a device_id/context substitution trick: the request
+	// is well-formed and the device is real, just bound to a DIFFERENT
+	// access point than the one named in the URL.
+	h, apRepo, evRepo := newDeviceBindingTestHandler()
+	apRepo.seed(model.AccessPoint{
+		ID: primitive.NewObjectID(), Name: "AP kendi cihazı", Kind: model.AccessPointKindCustom,
+		PricingMode: model.PricingModeFree, Currency: "TRY", Status: model.AccessPointStatusActive,
+		DeviceBindings: []string{"dev-1"},
+	})
+	otherID := apRepo.seed(model.AccessPoint{
+		Name: "Başka kurumun noktası", Kind: model.AccessPointKindCustom, PricingMode: model.PricingModeFree,
+		Currency: "TRY", Status: model.AccessPointStatusActive, DeviceBindings: []string{"dev-2"},
+	})
+	c, w := newDeviceBindingTestContext(http.MethodPost, "/device/access-points/"+otherID.Hex()+"/events", "{}",
+		gin.Params{{Key: "id", Value: otherID.Hex()}})
+	c.Set("user_type", "api_client")
+	c.Set("userID", "dev-1")
+
+	h.RecordEvent(c)
+
+	if w.Code != http.StatusForbidden {
+		t.Fatalf("expected 403, got %d (body: %s)", w.Code, w.Body.String())
+	}
+	if strings.Contains(w.Body.String(), "Başka kurumun noktası") {
+		t.Fatalf("response leaked the other access point's name: %s", w.Body.String())
+	}
+	if len(evRepo.inserted) != 0 {
+		t.Fatalf("expected no event to be written, got %d", len(evRepo.inserted))
+	}
+}
+
+func TestHTTP_CancelBoardingTrip_UnboundDevice_Returns403(t *testing.T) {
+	h, apRepo, _ := newDeviceBindingTestHandler()
+	apID := apRepo.seed(model.AccessPoint{
+		Name: "Servis", Kind: model.AccessPointKindFareTransport, PricingMode: model.PricingModeMetered,
+		Currency: "TRY", Status: model.AccessPointStatusActive, DeviceBindings: []string{"bound-device"},
+	})
+	tripID := primitive.NewObjectID()
+	c, w := newDeviceBindingTestContext(http.MethodPost,
+		"/device/access-points/"+apID.Hex()+"/rider-trips/"+tripID.Hex()+"/cancel", "",
+		gin.Params{{Key: "id", Value: apID.Hex()}, {Key: "tripId", Value: tripID.Hex()}})
+	c.Set("user_type", "api_client")
+	c.Set("userID", "unbound-device")
+
+	h.CancelBoardingTrip(c)
+
+	if w.Code != http.StatusForbidden {
+		t.Fatalf("expected 403, got %d (body: %s)", w.Code, w.Body.String())
+	}
+}
+
+func TestHTTP_SettleTripCash_UnboundDevice_Returns403(t *testing.T) {
+	h, apRepo, _ := newDeviceBindingTestHandler()
