+func TestRecordEvent_BoundDeviceButInactiveAccessPoint_Rejected(t *testing.T) {
+	svc, apRepo, evRepo, _, _ := newTestService()
+	apID := apRepo.seed(t, model.AccessPoint{
+		Name: "Kantin", Kind: model.AccessPointKindCustom, PricingMode: model.PricingModeFree,
+		Currency: "TRY", Status: model.AccessPointStatusInactive, DeviceBindings: []string{"bound-device"},
+	})
+
+	_, err := svc.RecordEvent(context.Background(), apID, RecordEventInput{
+		ActorID: "bound-device", CallerIsAPIClient: true,
+	})
+
+	// The guard's own active check runs ahead of (and independently of)
+	// RecordEvent's separate requireActiveAccessPoint call, so a bound but
+	// inactive access point is still a device-binding rejection, not merely
+	// "falls through to the same later check" — this access point and
+	// device model have no other "is this device allowed right now" flag,
+	// so Status is what "aktiflik durumu" means here.
+	if err != ErrDeviceNotBoundToAccessPoint {
+		t.Fatalf("expected ErrDeviceNotBoundToAccessPoint for an inactive access point, got %v", err)
+	}
+	if len(evRepo.items) != 0 {
+		t.Fatalf("expected no event to be written, got %d", len(evRepo.items))
+	}
+}
+
+// TestRecordEvent_IdempotencyReplay_CannotLeakAnotherAccessPointsEvent proves
+// the one path that bypasses the normal FindByID(accessPointID) + guard
+// order: RecordEvent's own idempotency-key short-circuit, which looks up the
+// existing event by key alone (tenant/site-scoped only, not
+// access-point-scoped — see FindByIdempotencyKey). Without the fix, a device
+// bound to AP_Y replaying (or guessing) AP_X's idempotency key would get back
+// AP_X's event — including its wallet/person/amount — without ever being
+// checked against AP_X's own DeviceBindings.
+func TestRecordEvent_IdempotencyReplay_CannotLeakAnotherAccessPointsEvent(t *testing.T) {
+	svc, apRepo, evRepo, _, _ := newTestService()
+	apX := apRepo.seed(t, model.AccessPoint{
+		Name: "AP-X", Kind: model.AccessPointKindCustom, PricingMode: model.PricingModeFree,
+		Currency: "TRY", Status: model.AccessPointStatusActive, DeviceBindings: []string{"dev-x"},
+	})
+	apY := apRepo.seed(t, model.AccessPoint{
+		Name: "AP-Y", Kind: model.AccessPointKindCustom, PricingMode: model.PricingModeFree,
+		Currency: "TRY", Status: model.AccessPointStatusActive, DeviceBindings: []string{"dev-y"},
+	})
+
+	// dev-x's own, legitimate first call — recorded against AP_X.
+	first, err := svc.RecordEvent(context.Background(), apX, RecordEventInput{
+		ActorID: "dev-x", CallerIsAPIClient: true, IdempotencyKey: "shared-key",
+	})
+	if err != nil {
+		t.Fatalf("seed event failed: %v", err)
+	}
+	if len(evRepo.items) != 1 {
+		t.Fatalf("expected exactly 1 seed event, got %d", len(evRepo.items))
+	}
+
+	// dev-y, bound only to AP_Y, replays/guesses the same key against AP_Y's
+	// own URL — must be rejected, and must NOT get AP_X's event back.
+	leaked, err := svc.RecordEvent(context.Background(), apY, RecordEventInput{
+		ActorID: "dev-y", CallerIsAPIClient: true, IdempotencyKey: "shared-key",
+	})
+	if err != ErrDeviceNotBoundToAccessPoint {
+		t.Fatalf("expected ErrDeviceNotBoundToAccessPoint, got err=%v event=%v", err, leaked)
+	}
+	if len(evRepo.items) != 1 {
+		t.Fatalf("expected no new event to be written, got %d", len(evRepo.items))
+	}
+
+	// dev-x itself retrying with the same key (e.g. a lost response) must
+	// still get its own event back — the fix must not break the legitimate
+	// offline-retry case.
+	replayed, err := svc.RecordEvent(context.Background(), apX, RecordEventInput{
+		ActorID: "dev-x", CallerIsAPIClient: true, IdempotencyKey: "shared-key",
+	})
+	if err != nil || replayed == nil || replayed.ID != first.ID {
+		t.Fatalf("expected dev-x's own retry to return its original event, got err=%v event=%v", err, replayed)
+	}
+	if len(evRepo.items) != 1 {
+		t.Fatalf("expected the retry to insert nothing new, got %d", len(evRepo.items))
+	}
+}
